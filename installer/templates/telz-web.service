[Unit]
Description=Telz Web
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG LD_PROFILE LD_ORIGIN_PATH LD_HWCAP_MASK GLIBC_TUNABLES GCONV_PATH LOCPATH NLSPATH MALLOC_CHECK_ MALLOC_PERTURB_ PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE PYTHONINSPECT PYTHONWARNINGS PYTHONBREAKPOINT NODE_OPTIONS NODE_PATH NODE_REPL_EXTERNAL_MODULE NODE_EXTRA_CA_CERTS NODE_ICU_DATA OPENSSL_CONF OPENSSL_MODULES PATH HOME TMPDIR TELZ_PROJECT_ROOT NODE_ENV PORT WHATSAPP_GATEWAY_RUNTIME_HOST WHATSAPP_GATEWAY_RUNTIME_PORT WHATSAPP_GATEWAY_RUNTIME_DATA_DIR PYTHONDONTWRITEBYTECODE PYTHONNOUSERSITE
InaccessiblePaths=__INSTALL_DIR__/backend/.env __INSTALL_DIR__/.runtime
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ExecStart=/usr/bin/env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/nonexistent TMPDIR=/tmp TELZ_PROJECT_ROOT=__INSTALL_DIR__ NODE_ENV=production PORT=__WEB_PORT__ /usr/bin/node __CODE_DIR__/dist/server/node-build.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
