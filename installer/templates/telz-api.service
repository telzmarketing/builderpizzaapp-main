[Unit]
Description=Telz API
After=network.target postgresql.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/backend/.env
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG LD_PROFILE LD_ORIGIN_PATH LD_HWCAP_MASK GLIBC_TUNABLES GCONV_PATH LOCPATH NLSPATH MALLOC_CHECK_ MALLOC_PERTURB_ PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE PYTHONINSPECT PYTHONWARNINGS PYTHONBREAKPOINT NODE_OPTIONS NODE_PATH NODE_REPL_EXTERNAL_MODULE NODE_EXTRA_CA_CERTS NODE_ICU_DATA OPENSSL_CONF OPENSSL_MODULES PATH HOME TMPDIR TELZ_PROJECT_ROOT NODE_ENV PORT WHATSAPP_GATEWAY_RUNTIME_HOST WHATSAPP_GATEWAY_RUNTIME_PORT WHATSAPP_GATEWAY_RUNTIME_DATA_DIR PYTHONDONTWRITEBYTECODE PYTHONNOUSERSITE
BindPaths=__INSTALL_DIR__/uploads:__CODE_DIR__/uploads
ExecStart=/usr/bin/env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/nonexistent TMPDIR=/tmp TELZ_PROJECT_ROOT=__INSTALL_DIR__ PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 __CODE_DIR__/.venv/bin/uvicorn --app-dir __CODE_DIR__ backend.main:app --host 127.0.0.1 --port __API_PORT__ --workers __API_WORKERS__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
