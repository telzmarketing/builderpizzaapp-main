[Unit]
Description=Telz - WhatsApp Gateway Baileys Runtime
After=network.target telz-api.service
Wants=telz-api.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/backend/.env
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG LD_PROFILE LD_ORIGIN_PATH LD_HWCAP_MASK GLIBC_TUNABLES GCONV_PATH LOCPATH NLSPATH MALLOC_CHECK_ MALLOC_PERTURB_ PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE PYTHONINSPECT PYTHONWARNINGS PYTHONBREAKPOINT NODE_OPTIONS NODE_PATH NODE_REPL_EXTERNAL_MODULE NODE_EXTRA_CA_CERTS NODE_ICU_DATA OPENSSL_CONF OPENSSL_MODULES PATH HOME TMPDIR TELZ_PROJECT_ROOT NODE_ENV PORT WHATSAPP_GATEWAY_RUNTIME_HOST WHATSAPP_GATEWAY_RUNTIME_PORT WHATSAPP_GATEWAY_RUNTIME_DATA_DIR PYTHONDONTWRITEBYTECODE PYTHONNOUSERSITE
ExecStart=/usr/bin/env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/nonexistent TMPDIR=/tmp TELZ_PROJECT_ROOT=__INSTALL_DIR__ NODE_ENV=production WHATSAPP_GATEWAY_RUNTIME_HOST=127.0.0.1 WHATSAPP_GATEWAY_RUNTIME_PORT=__WHATSAPP_GATEWAY_PORT__ WHATSAPP_GATEWAY_RUNTIME_DATA_DIR=__INSTALL_DIR__/.runtime/baileys /usr/bin/node __CODE_DIR__/server/whatsapp-gateway-runtime.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telz-whatsapp-gateway

[Install]
WantedBy=multi-user.target
