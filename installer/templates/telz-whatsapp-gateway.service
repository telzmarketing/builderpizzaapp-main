[Unit]
Description=Telz - WhatsApp Gateway Baileys Runtime
After=network.target telz-api.service
Wants=telz-api.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
Environment=NODE_ENV=production
Environment=WHATSAPP_GATEWAY_RUNTIME_HOST=127.0.0.1
Environment=WHATSAPP_GATEWAY_RUNTIME_PORT=__WHATSAPP_GATEWAY_PORT__
Environment=WHATSAPP_GATEWAY_RUNTIME_DATA_DIR=__INSTALL_DIR__/.runtime/baileys
EnvironmentFile=__INSTALL_DIR__/backend/.env
ExecStart=/usr/bin/node server/whatsapp-gateway-runtime.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telz-whatsapp-gateway

[Install]
WantedBy=multi-user.target
