# ── Banco de dados ────────────────────────────────────────────────────────────
# Formato: postgresql://usuario:senha@host:porta/nome_banco
# Substitua "minhaloja" e "minhaloja_user" pelos valores gerados pelo setup_database.sh
# (ou consulte o arquivo db_connection.txt criado pelo script)
DATABASE_URL=postgresql://minhaloja_user:SENHA@localhost:5432/minhaloja

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_NAME=PizzaApp API
APP_VERSION=1.0.0
DEBUG=false

# ── CORS (origens permitidas, separadas por vírgula) ─────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
PUBLIC_STORE_URL=http://localhost:5173

# ── Autenticação admin (JWT) ──────────────────────────────────────────────────
# Gere uma chave segura em produção: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=TROQUE_POR_CHAVE_GERADA_COM__python3_-c_import_secrets_print_secrets.token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Conta admin inicial (criada no primeiro boot do banco) ────────────────────
# Troque antes de iniciar pela primeira vez. Não pode ser vazio em produção.
ADMIN_EMAIL=admin@minhaloja.com.br
ADMIN_NAME=Administrador
ADMIN_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI

# ── Gateway de pagamento ──────────────────────────────────────────────────────
# Multi-gateway: o roteamento final e salvo em /painel/pagamentos.
# Estas variaveis inicializam a configuracao quando o banco ainda esta vazio.
# Dominio unico: payments. Nao criar um segundo dominio de pagamentos.
PAYMENT_GATEWAY=mercadopago
PAYMENT_PROVIDER=mercado_pago

# Mercado Pago preservado para Pix/cartao e compatibilidade do fluxo atual.
# Webhook publico: /webhooks/mercadopago e /api/webhooks/mercadopago.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# ASAAS habilitado para Pix e cartao no fluxo seguro dedicado.
# Dados de cartao nao podem ser salvos em banco, logs ou storage local.
# Webhook publico: /webhooks/asaas e /api/webhooks/asaas.
# ASAAS_WEBHOOK_TOKEN nao e a API key; use um token forte exclusivo.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Legado/compatibilidade com configuracoes antigas do projeto.
PAYMENT_SECRET_KEY=sua_chave_secreta_aqui
PAYMENT_WEBHOOK_SECRET=sua_chave_webhook_aqui

# ── Fidelidade ────────────────────────────────────────────────────────────────
POINTS_PER_REAL=1.0      # pontos por R$ gasto
DELIVERY_POINTS=10       # bônus por pedido entregue
# Chatbot / IA
# Configure pelo menos uma chave para o chatbot responder fora do fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# WhatsApp Gateway / Baileys runtime local
# A porta 3020 deve ficar local, sem exposicao publica no Nginx.
WHATSAPP_GATEWAY_RUNTIME_URL=http://127.0.0.1:3020
WHATSAPP_GATEWAY_RUNTIME_TOKEN=
WHATSAPP_GATEWAY_RUNTIME_TIMEOUT_SECONDS=8
WHATSAPP_GATEWAY_RUNTIME_DATA_DIR=/home/deploy/.local/state/moschettieri/baileys
WHATSAPP_GATEWAY_BACKEND_EVENT_URL=http://127.0.0.1:8000/api/whatsapp-gateway/runtime/events
WHATSAPP_GATEWAY_EVENT_TOKEN=

# Snapshots sanitizados gerados pelo observador root-owned e lidos pela Central Master.
PLATFORM_MONITORING_SNAPSHOT_DIR=/var/lib/telz/monitoring
